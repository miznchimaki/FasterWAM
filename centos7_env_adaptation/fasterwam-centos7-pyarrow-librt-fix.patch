+PYARROW_PROBE = r'''
+import sys
+if any(name == "torch" or name.startswith("torch.") for name in sys.modules):
+    raise RuntimeError("Python startup imported torch; cannot check PyArrow independently")
+import pyarrow as pa
+import pyarrow.compute as pc
